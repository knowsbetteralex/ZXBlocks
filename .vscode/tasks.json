{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ZXBlocks: build",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "windows": {
                "command": "${workspaceFolder}/.venv/Scripts/python.exe"
            },
            "args": [
                "-m",
                "zxblocks",
                "build",
                "examples/border_cycle/project.json",
                "-o",
                "build/examples/border_cycle"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "ZXBlocks: build debug snapshot",
            "dependsOn": "ZXBlocks: build",
            "type": "process",
            "command": "sjasmplus",
            "args": [
                "--fullpath=rel",
                "--sld=build/examples/border_cycle/border_cycle.sld",
                "tools/debug_border_cycle.asm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "ZXBlocks: build editor",
            "type": "shell",
            "command": "npm",
            "args": ["run", "build"],
            "options": {"cwd": "${workspaceFolder}/editor"},
            "problemMatcher": []
        },
        {
            "label": "ZXBlocks: editor",
            "dependsOn": "ZXBlocks: build editor",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "windows": {"command": "${workspaceFolder}/.venv/Scripts/python.exe"},
            "args": ["-m", "zxblocks", "editor", "--open"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "ZXBlocks: build keyboard example",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "windows": {"command": "${workspaceFolder}/.venv/Scripts/python.exe"},
            "args": ["-m", "zxblocks", "build", "examples/keyboard_border/project.json", "-o", "build/examples/keyboard_border"],
            "options": {"cwd": "${workspaceFolder}"},
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "ZXBlocks: keyboard debug snapshot",
            "dependsOn": "ZXBlocks: build keyboard example",
            "type": "process",
            "command": "sjasmplus",
            "args": ["--fullpath=rel", "--sld=build/examples/keyboard_border/keyboard_border.sld", "tools/debug_keyboard_border.asm"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "ZXBlocks: run keyboard in EmuZWin",
            "dependsOn": "ZXBlocks: keyboard debug snapshot",
            "type": "process",
            "command": "emuz",
            "args": ["${workspaceFolder}\\build\\examples\\keyboard_border\\keyboard_border.sna"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "ZXBlocks: run EmuZWin",
            "dependsOn": "ZXBlocks: build debug snapshot",
            "type": "process",
            "command": "emuz",
            "args": [
                "${workspaceFolder}\\build\\examples\\border_cycle\\border_cycle.sna"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
